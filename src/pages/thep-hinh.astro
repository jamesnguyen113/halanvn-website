---
import Base from '../layouts/Base.astro';
import SeoCrossLinks from '../components/SeoCrossLinks.astro';
import { site } from '../data/site';

const faq = [
  {
    q: 'Thép hình gồm những loại nào?',
    a: 'Bốn dòng chính: thép H (tiết diện chữ H, cán nóng, chịu lực dọc trục lớn), thép I (tiết diện chữ I, tương tự thép H nhưng cánh hẹp hơn), thép U (kênh, tiết diện chữ U, cán nóng — khác với xà gồ C cán nguội), và thép V (thép góc đều cạnh, tiết diện chữ L). Mỗi loại phù hợp một vị trí kết cấu khác nhau trong cùng một công trình.',
  },
  {
    q: 'Khi nào dùng thép hình, khi nào dùng xà gồ C, Z?',
    a: 'Thép hình H, I là thép cán nóng, tiết diện đặc và dày, dùng làm cột, dầm chính, kết cấu chịu lực chính của nhà xưởng, nhà thép tiền chế. Xà gồ C, Z là thép cán nguội từ tôn cuộn mỏng hơn, dùng làm cấu kiện phụ đỡ trực tiếp tấm tôn mái và tôn vách. Nói đơn giản: thép hình chịu lực chính, xà gồ đỡ mái — hai loại đi cùng nhau chứ không thay thế nhau.',
  },
  {
    q: 'Thép U cán nóng khác gì xà gồ C cán nguội?',
    a: 'Cùng tiết diện chữ U/C nhưng khác công nghệ và chức năng: thép U cán nóng từ phôi thép đặc, thành dày, dùng làm dầm, giằng, khung kết cấu chịu lực. Xà gồ C cán nguội từ tôn cuộn mỏng gấp định hình, nhẹ hơn nhiều, chỉ dùng đỡ mái tôn theo khoảng cách tính toán — xem thêm trang xà gồ C, Z.',
  },
  {
    q: 'Mua thép hình ở Hà Lan có xuất hóa đơn VAT không?',
    a: 'Có. Thép hình Hà Lan cung cấp nguồn hàng nhà máy lớn, đầy đủ chứng chỉ CO/CQ và xuất hóa đơn VAT theo yêu cầu — phù hợp công trình cần quyết toán, đấu thầu.',
  },
  {
    q: 'Đặt thép hình cùng xà gồ, tôn lợp có được giao chung không?',
    a: `Được. Nhiều khách công trình đặt thép hình làm khung cột, dầm chính cùng lúc với xà gồ C, Z và tôn lợp mái trong một đơn — Hà Lan gom hàng, giao một chuyến tận công trình tại TP.HCM, Bình Dương, Tây Ninh, tiết kiệm chi phí vận chuyển. Gọi ${site.hotline.display} để đặt gộp.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Trang chủ', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Thép hình' },
  ],
};

const sizes = [
  { kind: 'Thép H', specs: 'H100x100 · H150x150 · H150x75 · H200x200 · H200x100 · H250x125 · H250x250 · H300x150 · H300x300 · H350x350 · H400x400 mm' },
  { kind: 'Thép I', specs: 'I100 · I120 · I150 · I200 · I250 · I300 mm' },
  { kind: 'Thép U (kênh)', specs: 'U80 · U100 · U120 · U140 · U160 · U180 · U200 · U250 · U300 mm' },
  { kind: 'Thép V (thép góc)', specs: 'V25x25 · V30x30 · V40x40 · V50x50 · V63x63 · V75x75 · V100x100 mm, dày 3 — 12 mm' },
  { kind: 'Chiều dài cây', specs: '6 m và 12 m tiêu chuẩn' },
];
---

<Base
  title="Thép hình H — U — I — V — giá hôm nay, đủ quy cách | Hà Lan"
  description={`Mua thép hình H, I, U, V cán nóng đủ quy cách cho khung kèo, kết cấu nhà xưởng. Giao tận công trình TP.HCM, Bình Dương. Gọi ${site.hotline.display} báo giá thép hình hôm nay.`}
  schema={[breadcrumbSchema, faqSchema]}
>
  <div class="bg-steel-950 py-10 text-white">
    <div class="mx-auto max-w-6xl px-4">
      <p class="eyebrow text-brand-soft">Sắt thép xây dựng</p>
      <h1 class="display mt-2 text-3xl sm:text-4xl">Thép hình H — U — I — V — đủ quy cách</h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-steel-300">
        Thép hình cán nóng làm cột, dầm chính, khung kết cấu nhà xưởng — gọi{' '}
        <a href={`tel:${site.hotline.tel}`} class="font-bold text-white underline">{site.hotline.display}</a>{' '}
        để có giá thép hình hôm nay.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-10">
    <section class="max-w-3xl space-y-3 text-[0.95rem] leading-relaxed text-steel-800">
      <p>
        <strong>Thép hình</strong> là thép cán nóng từ phôi thép đặc, tiết diện định hình sẵn theo
        bốn dạng chính — <strong>thép H</strong> (chữ H, chịu lực dọc trục và uốn tốt cả hai
        phương), <strong>thép I</strong> (chữ I, cánh hẹp hơn thép H, thường dùng làm dầm),{' '}
        <strong>thép U</strong> (kênh, chữ U, dùng làm giằng, dầm phụ, khung cửa) và{' '}
        <strong>thép V</strong> (thép góc đều cạnh, chữ L, dùng làm giằng chéo, khung phụ, chân đế
        thiết bị). Đây là nhóm cấu kiện <strong>chịu lực chính</strong> của nhà thép tiền chế —
        khác với xà gồ C, Z cán nguội chỉ đỡ trực tiếp tấm tôn mái.
      </p>
      <p>
        Nguồn hàng nhà máy lớn, đầy đủ chứng chỉ CO/CQ, xuất hóa đơn VAT — nhiều khách công trình
        đặt thép hình làm cột, kèo chính cùng lúc với xà gồ C, Z và tôn lợp mái; Hà Lan gom hàng
        giao một chuyến tận công trình tại TP.HCM, Thủ Đức, Bình Dương, Tây Ninh, tiết kiệm chi phí
        vận chuyển so với đặt riêng từng loại vật tư.
      </p>
    </section>

    <section class="mt-10 max-w-3xl">
      <h2 class="display border-l-4 border-brand pl-3 text-xl text-steel-950">Quy cách thép hình Hà Lan</h2>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-steel-950 text-left text-white">
              <th class="px-3 py-2.5 font-semibold">Thông số</th>
              <th class="px-3 py-2.5 font-semibold">Quy cách</th>
            </tr>
          </thead>
          <tbody>
            {sizes.map((s, i) => (
              <tr class:list={[i % 2 ? 'bg-steel-50' : 'bg-white', 'border-b border-steel-200']}>
                <td class="px-3 py-2.5 font-semibold text-steel-950">{s.kind}</td>
                <td class="px-3 py-2.5 text-steel-700">{s.specs}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-steel-500">
        Quy cách tham khảo — Hà Lan còn cung cấp thép vằn D10 — D40, sắt hộp, ống phi tròn. Xem đầy
        đủ tại trang <a href="/san-pham/sat-thep-xay-dung/" class="text-brand underline">sắt thép xây dựng</a>.
      </p>
    </section>

    <div class="mt-10 border-l-4 border-brand bg-steel-50 p-5">
      <p class="display text-lg text-steel-950">Giá thép hình theo ngày — gọi để chốt</p>
      <p class="mt-1 text-sm text-steel-700">
        Giá thay đổi theo thị trường thép và quy cách. Đọc quy cách, chiều dài và số lượng qua điện
        thoại — báo giá chính xác trong ngày, đã gồm VAT.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`tel:${site.hotline.tel}`}
          class="display bg-brand px-5 py-3 text-sm tracking-widest text-white uppercase hover:bg-brand-hot"
        >
          {site.hotline.display}
        </a>
        <a
          href={site.zaloUrl}
          target="_blank"
          rel="noopener"
          class="display border border-steel-950 px-5 py-3 text-sm tracking-widest text-steel-950 uppercase hover:bg-steel-950 hover:text-white"
        >
          Nhắn Zalo
        </a>
      </div>
    </div>

    <section class="mt-12 max-w-3xl">
      <h2 class="display border-l-4 border-brand pl-3 text-xl text-steel-950">
        Thép hình hay xà gồ C, Z — khi nào dùng loại nào?
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-steel-700">
        Một nhà thép tiền chế thường dùng cả hai, mỗi loại đúng vị trí của nó:
      </p>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-steel-700">
        <li>
          <strong>Thép hình H, I</strong> làm cột chính, kèo chính, dầm — chịu toàn bộ tải trọng
          công trình truyền xuống móng. Cán nóng, tiết diện đặc, thành dày nên chịu lực dọc trục và
          uốn lớn.
        </li>
        <li>
          <strong>Thép U cán nóng</strong> làm giằng, dầm phụ, khung cửa, khung đỡ thiết bị — thành
          dày hơn xà gồ U cán nguội nhiều lần dù cùng hình dáng tiết diện.
        </li>
        <li>
          <strong>Thép V (thép góc)</strong> làm giằng chéo mái, giằng cột, khung phụ nhẹ, chân đế
          máy móc, kệ giá.
        </li>
        <li>
          <strong>Xà gồ C, Z</strong> (xem trang{' '}
          <a href="/san-pham/xa-go/" class="text-brand underline">xà gồ C — Z</a>) là cấu kiện phụ,
          cán nguội từ tôn cuộn mỏng, gắn trực tiếp lên khung thép hình để đỡ tấm tôn mái và tôn
          vách — không chịu lực chính của công trình.
        </li>
      </ul>
      <p class="mt-3 text-sm font-semibold text-steel-800">
        Gọi <a href={`tel:${site.hotline.tel}`} class="text-brand underline">{site.hotline.display}</a> —
        Hà Lan tư vấn quy cách thép hình và xà gồ phù hợp bản vẽ kết cấu công trình.
      </p>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="display border-l-4 border-brand pl-3 text-xl text-steel-950">Ứng dụng thường gặp</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-steel-700">
        <li>Cột, kèo chính nhà xưởng, nhà thép tiền chế.</li>
        <li>Dầm cầu trục, dầm sàn thao tác trong nhà xưởng.</li>
        <li>Giằng mái, giằng cột, khung đỡ thiết bị công nghiệp.</li>
        <li>Khung cổng, khung cửa lớn, kết cấu bến bãi.</li>
        <li>Chân đế, khung bệ máy, kệ giá chịu tải nặng.</li>
      </ul>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="display border-l-4 border-brand pl-3 text-xl text-steel-950">Câu hỏi thường gặp</h2>
      <div class="mt-4 space-y-5">
        {faq.map((f) => (
          <div>
            <h3 class="font-semibold text-steel-950">{f.q}</h3>
            <p class="mt-1 text-sm leading-relaxed text-steel-700">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <SeoCrossLinks current="/thep-hinh/" />
  </div>
</Base>
